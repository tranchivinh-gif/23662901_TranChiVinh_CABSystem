# Reference values used by CAB_APP/compose.yaml for the local demo.
# Compose sets these values directly; copying this file to .env does not configure the app.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
NODE_ENV=development
CAB_PROFILE=demo-test
CAB_JWT_ISSUER=cab-system
CAB_JWT_AUDIENCE=cab-public-api
CAB_JWT_ACTIVE_KEY_ID=v1

# There is no DATABASE_URL: seven services use separate PostgreSQL databases.
# There is no JWT_SECRET: RS256 keys and database passwords are generated in Docker volumes.
